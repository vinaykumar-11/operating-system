#include <stdio.h>
#include <stdlib.h>
#include <math.h>

int main() {
    int n, head, seek = 0;
    printf("Enter number of disk requests: ");
    scanf("%d", &n);

    int requests[n];
    printf("Enter the disk request sequence: ");
    for(int i = 0; i < n; i++)
        scanf("%d", &requests[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    int current = head;
    for(int i = 0; i < n; i++) {
        seek += abs(requests[i] - current);
        current = requests[i];
    }

    printf("Total seek time: %d\n", seek);
    return 0;
}
