#include <stdio.h>

int main() {
    int n, m, i, j, k;
    printf("Enter number of pages: ");
    scanf("%d", &n);

    int pages[n];
    printf("Enter page reference string:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter number of frames: ");
    scanf("%d", &m);

    int frames[m];
    for (i = 0; i < m; i++)
        frames[i] = -1;

    int faults = 0;

    for (i = 0; i < n; i++) {
        int page = pages[i];
        int found = 0;

        for (j = 0; j < m; j++) {
            if (frames[j] == page) {
                found = 1;
                break;
            }
        }

        if (!found) {
            int replace_index = -1, farthest = -1;

            for (j = 0; j < m; j++) {
                if (frames[j] == -1) {
                    replace_index = j;
                    break;
                }

                int next_use = 0;
                for (k = i + 1; k < n; k++) {
                    if (frames[j] == pages[k])
                        break;
                }
                next_use = k;

                if (next_use > farthest) {
                    farthest = next_use;
                    replace_index = j;
                }
            }

            frames[replace_index] = page;
            faults++;
        }

        printf("Frames after accessing page %d: ", page);
        for (j = 0; j < m; j++)
            printf("%d ", frames[j]);
        printf("\n");
    }

    printf("\nTotal Page Faults: %d\n", faults);
    return 0;
}
