#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, i;
    printf("Enter total number of blocks on disk: ");
    scanf("%d", &n);

    int disk[n];
    for (i = 0; i < n; i++)
        disk[i] = 0; // 0 = free, 1 = allocated

    int start, length;
    char choice;

    do {
        printf("\nEnter starting block: ");
        scanf("%d", &start);
        printf("Enter length of file (number of blocks): ");
        scanf("%d", &length);

        if (start < 0 || start + length > n) {
            printf("Error: Out of disk bounds.\n");
        } else {
            int can_allocate = 1;
            for (i = start; i < start + length; i++) {
                if (disk[i] == 1) {
                    can_allocate = 0;
                    break;
                }
            }

            if (can_allocate) {
                for (i = start; i < start + length; i++)
                    disk[i] = 1;
                printf("File allocated from block %d to %d.\n", start, start + length - 1);
            } else {
                printf("Error: Blocks are already allocated.\n");
            }
        }

        printf("Do you want to allocate another file? (y/n): ");
        scanf(" %c", &choice);
    } while (choice == 'y' || choice == 'Y');

    printf("\nDisk allocation status:\n");
    for (i = 0; i < n; i++)
        printf("Block %d: %s\n", i, disk[i] ? "Allocated" : "Free");

    return 0;
}
